    <!-- 模块说明 -->
    <string name="desc_remote_view_page">Overlay custom widgets on the Pilot UI (TextView/Button/EditText, etc.) with real-time property updates.</string>
    <string name="desc_ar">Overlay AR points on map/live view with icon projection (perspective/orthographic), text labels and radar rings.</string>
    <string name="desc_map">Add markers, circles, polygons and polylines to the Pilot map, with click callbacks and state subscription.</string>
    <string name="desc_dialog">Show alert, confirm, prompt and single/multi choice dialogs in Pilot with user action callbacks.</string>
    <string name="desc_camera_drawing">Overlay rectangles, filled polygons and custom text on the live view, for object detection visualization.</string>
    <string name="desc_navigate">Navigate Pilot to a specified page (home/map/waypoint list/album, etc.).</string>
    <string name="desc_waypoint">Push KMZ files to Pilot/aircraft with mission control, resume and state subscription.</string>
    <string name="desc_key">DJI Key-Value channel, supporting getValue/setValue/listen/performAction.</string>
    <string name="desc_file_transfer">Upload plugin files to the private or Pilot log destination. Deletion is unavailable in the current SDK.</string>
    <string name="desc_pipeline">Establish a MOP data pipeline with the aircraft, supporting connect/read-write/chunked large data transfer.</string>
    <string name="desc_camera_stream">Subscribe to camera stream frame data callbacks for a specified channel.</string>
    <string name="desc_area_code">Query and update country code, with country code change subscription.</string>
    <string name="desc_language">Get the current Pilot APP language and subscribe to language change events.</string>
    <string name="desc_remote_control">Switch the primary camera of the Pilot main view (by ComponentIndexType).</string>
    <string name="desc_disconnect_action">Configure Key actions executed automatically on disconnect to prevent abnormal device state.</string>
    <string name="desc_intelligent">Set frame capture mode, subscribe to auto-recognition target notifications, and download captured frames.</string>
    <string name="desc_modeling">Subscribe to modeling task state and export modeling result files to a public directory.</string>
    <string name="desc_media_task">Browse camera media, load previews, resume-download originals, read XMP and parse thermal photos.</string>
    <string name="desc_link">SDK initialization and Pilot server connection state subscription (integrated on the main screen).</string>

