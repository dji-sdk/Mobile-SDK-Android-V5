    <!-- 模块说明 -->
    <string name="desc_remote_view_page">在 Pilot 界面叠加自定义控件，支持 TextView/Button/EditText 等，可实时更新属性。</string>
    <string name="desc_ar">向地图/图传叠加 AR 信息点，支持图标投射（透视/正交）、文字标注和雷达圈。</string>
    <string name="desc_map">向 Pilot 地图添加标记、圆、多边形、折线等元素，支持点击回调和状态订阅。</string>
    <string name="desc_dialog">在 Pilot 弹出提示框、确认框、输入框、单选/多选框，支持用户操作回调。</string>
    <string name="desc_camera_drawing">在图传画面叠加矩形框、实心多边形和自定义文字，适用于目标检测可视化。</string>
    <string name="desc_navigate">控制 Pilot 跳转到指定页面（首页/地图/航线列表/相册等）。</string>
    <string name="desc_waypoint">KMZ 文件推送到 Pilot/飞机，支持任务控制、断点续飞和状态订阅。</string>
    <string name="desc_key">DJI Key-Value 通道，支持 getValue/setValue/listen/performAction。</string>
    <string name="desc_file_transfer">上传插件文件到插件私有目录或 Pilot 日志目录。当前 SDK 不支持删除。</string>
    <string name="desc_pipeline">建立与飞机的 MOP 数据管道，支持连接/读写/分块大数据传输。</string>
    <string name="desc_camera_stream">订阅指定通道的相机码流帧数据回调。</string>
    <string name="desc_area_code">查询和更新国家码，支持国家码变更订阅。</string>
    <string name="desc_language">获取 Pilot APP 当前语言，订阅语言切换变更事件。</string>
    <string name="desc_remote_control">切换 Pilot 主画面的主相机（指定 ComponentIndexType）。</string>
    <string name="desc_disconnect_action">配置断连时自动执行的 Key 操作，防止断联后设备状态异常。</string>
    <string name="desc_intelligent">设置截帧模式、订阅自动识别目标通知、下载截帧文件。</string>
    <string name="desc_modeling">订阅建模任务状态，将建模结果文件导出到公共目录。</string>
    <string name="desc_media_task">浏览相机媒体文件、加载预览图、断点下载原文件、读取 XMP 与解析热成像照片。</string>
    <string name="desc_link">SDK 初始化与 Pilot 服务端连接状态订阅（已在主界面集成）。</string>

