<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="4dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:background="@drawable/bg_card_thumb_placeholder">

            <ImageView
                android:id="@+id/iv_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_thumb_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/media_unknown"
                android:textColor="@color/card_thumb_text"
                android:textSize="9sp" />

            <ProgressBar
                android:id="@+id/progress_thumb"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <View
                android:id="@+id/view_selection_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_media_selection_overlay"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_selection_badge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_margin="3dp"
                android:background="@drawable/bg_media_selection_badge"
                android:gravity="center"
                android:text="@string/media_selected_mark"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:paddingHorizontal="5dp"
            android:paddingTop="4dp"
            android:textColor="@color/card_title_text"
            android:textSize="10sp"
            tools:text="DJI_0001.JPG" />

        <TextView
            android:id="@+id/tv_file_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="5dp"
            android:paddingBottom="4dp"
            android:textColor="@color/card_desc_text"
            android:textSize="9sp"
            tools:text="JPEG · 4.2 MB" />
    </LinearLayout>
</androidx.cardview.widget.CardView>