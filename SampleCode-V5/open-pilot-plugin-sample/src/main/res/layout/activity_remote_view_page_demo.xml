<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <!-- TopBar（现状不变） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@color/top_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/tv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:src="@drawable/icon_back"
            android:textColor="@color/card_desc_text"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/module_remote_view_page"
            android:textColor="@color/top_bar_title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="32dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- TopBar 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/top_bar_divider" />

    <!-- 左右分栏主体 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左侧：菜单列表（固定宽度，圆角 card 形式） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_menu"
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_rv_menu_card"
            android:clipToOutline="true"
            android:layout_margin="4dp"
            android:clipToPadding="false"
            android:paddingVertical="4dp" />

<!--        &lt;!&ndash; 竖向分割线 &ndash;&gt;-->
<!--        <View-->
<!--            android:layout_width="1dp"-->
<!--            android:layout_height="match_parent"-->
<!--            android:background="@color/top_bar_divider" />-->

        <!-- 右侧：详情区 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/page_bg">

            <!-- 默认提示（未选中时显示） -->
            <TextView
                android:id="@+id/tv_empty_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="@string/comp_hint_select"
                android:textColor="@color/hint_text"
                android:textSize="13sp"
                android:visibility="visible" />

            <!-- 选中后内容区（LinearLayout 垂直） -->
            <LinearLayout
                android:id="@+id/layout_detail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- 组件标题行（无 TopBar，直接文字） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_bg"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_comp_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/top_bar_title"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_comp_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/hint_text"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- 预览 WebView 容器，背景设在父布局 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/uxsdk_4_dp"
                    android:background="@drawable/bg_rv_web_view_card">
                    
                    <WebView
                        android:id="@+id/wv_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="@dimen/uxsdk_54_dp"/>
                </FrameLayout>

                <!-- 查看效果按钮（底部固定） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rv_menu_card"
                    android:gravity="center"
                    android:layout_margin="@dimen/uxsdk_4_dp"
                    android:paddingHorizontal="@dimen/uxsdk_8_dp"
                    android:paddingVertical="@dimen/uxsdk_4_dp"
                    android:orientation="vertical"
                    >

                    <TextView
                        android:id="@+id/tv_reference_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/uxsdk_4_dp"
                        android:paddingBottom="@dimen/uxsdk_4_dp"
                        android:textColor="@color/uxsdk_black_90_percent"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btn_view_effect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_view_effect_btn"
                        android:paddingVertical="8dp"
                        android:text="@string/btn_view_effect"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

</LinearLayout>
