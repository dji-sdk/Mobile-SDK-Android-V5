<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/demo_top_bar_disabled_bg" />
            <stroke android:width="1dp" android:color="@color/demo_top_bar_disabled_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/demo_top_bar_button_pressed" />
            <stroke android:width="1dp" android:color="@color/demo_top_bar_blue" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/demo_top_bar_bg" />
            <stroke android:width="1dp" android:color="@color/demo_top_bar_blue" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
