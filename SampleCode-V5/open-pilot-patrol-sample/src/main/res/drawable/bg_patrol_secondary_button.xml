<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/secondary_button_fill_pressed" />
            <stroke android:width="1dp" android:color="@color/secondary_button_stroke" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/secondary_button_fill" />
            <stroke android:width="1dp" android:color="@color/secondary_button_stroke" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
