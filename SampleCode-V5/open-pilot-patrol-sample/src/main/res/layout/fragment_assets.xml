<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:orientation="horizontal">
            <TextView
                android:id="@+id/chip_all"
                android:layout_width="72dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_patrol_chip"
                android:gravity="center"
                android:text="@string/filter_all"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/chip_photo"
                android:layout_width="72dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_patrol_chip"
                android:gravity="center"
                android:text="@string/filter_photo"
                android:textColor="#4D5965" />
            <TextView
                android:id="@+id/chip_route"
                android:layout_width="72dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_patrol_chip"
                android:gravity="center"
                android:text="@string/filter_route"
                android:textColor="#4D5965" />
            <TextView
                android:id="@+id/chip_point_event"
                android:layout_width="96dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_patrol_chip"
                android:gravity="center"
                android:text="@string/fw_asset_filter_point_event"
                android:textColor="#4D5965" />
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/grid_assets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E3E8EC" />

    <ScrollView android:layout_width="280dp" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">
            <ImageView
                android:id="@+id/iv_asset_preview"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="#111A2B"
                android:contentDescription="@string/asset_preview"
                android:scaleType="centerCrop" />
            <TextView
                android:id="@+id/tv_asset_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#17212B"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_asset_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_patrol_panel"
                android:padding="14dp"
                android:textColor="#56616C"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
