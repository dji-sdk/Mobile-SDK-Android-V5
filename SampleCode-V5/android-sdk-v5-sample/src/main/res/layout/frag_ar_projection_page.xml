<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/button_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintWidth_percent="0.15">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical">
            <Button
                android:id="@+id/btn_jump_to_home"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_jump_to_home"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btn_jump_to_map"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_jump_to_map"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_jump_to_home" />

            <Button
                android:id="@+id/btn_prepare_res"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_prepare_res"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_jump_to_map" />

            <Button
                android:id="@+id/btn_query_file_list_from_remote"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_query_file_list"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_prepare_res" />

            <Button
                android:id="@+id/btn_query_ar_config"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_query_ar_config"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_query_file_list_from_remote" />

            <Button
                android:id="@+id/btn_upload_ar_config"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_upload_ar_config"
                android:textSize="10sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_query_ar_config" />

            <Button
                android:id="@+id/btn_query_ar_info"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_query_ar_info"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_upload_ar_config" />

            <Button
                android:id="@+id/btn_add_ar_info"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_upload_ar_info"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_query_ar_info" />

            <Button
                android:id="@+id/btn_update_ar_info"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_update_ar_info"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_add_ar_info" />

            <Button
                android:id="@+id/btn_delete_ar_info"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_delete_ar_info"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_update_ar_info" />

            <!-- AR Line -->
            <Button
                android:id="@+id/btn_upload_ar_line"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_upload_ar_line"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_delete_ar_info" />

            <Button
                android:id="@+id/btn_query_ar_line"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_query_ar_line"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_upload_ar_line" />

            <Button
                android:id="@+id/btn_update_ar_line"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_update_ar_line"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_query_ar_line" />

            <Button
                android:id="@+id/btn_delete_ar_line"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_delete_ar_line"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_update_ar_line" />

            <!-- AR Polygon -->
            <Button
                android:id="@+id/btn_upload_ar_polygon"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_upload_ar_polygon"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_delete_ar_line" />

            <Button
                android:id="@+id/btn_query_ar_polygon"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_query_ar_polygon"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_upload_ar_polygon" />

            <Button
                android:id="@+id/btn_update_ar_polygon"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_update_ar_polygon"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_query_ar_polygon" />

            <Button
                android:id="@+id/btn_delete_ar_polygon"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_delete_ar_polygon"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_update_ar_polygon" />

            <!-- AR Circle -->
            <Button
                android:id="@+id/btn_upload_ar_circle"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_upload_ar_circle"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_delete_ar_polygon" />

            <Button
                android:id="@+id/btn_query_ar_circle"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_query_ar_circle"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_upload_ar_circle" />

            <Button
                android:id="@+id/btn_update_ar_circle"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_update_ar_circle"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_query_ar_circle" />

            <Button
                android:id="@+id/btn_delete_ar_circle"
                style="@style/ar_projection_fragment_btn"
                android:text="@string/btn_ar_delete_ar_circle"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_update_ar_circle" />

            <Button
                android:id="@+id/btn_enable_ar_radar"
                style="@style/main_fragment_btn"
                android:text="Enable AR Radar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_delete_ar_circle" />

            <Button
                android:id="@+id/btn_disable_ar_radar"
                style="@style/main_fragment_btn"
                android:text="Disable AR Radar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_enable_ar_radar" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cb_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:layout_constraintStart_toEndOf="@+id/button_list"
        app:layout_constraintTop_toTopOf="parent">

        <CheckBox
            android:id="@+id/cb_hide_ar_point"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="1"
            android:scaleY="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/cb_ar_hide_all"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cb_hide_ar_point"/>

        <CheckBox
            android:id="@+id/cb_hide_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="1"
            android:scaleY="1"
            app:layout_constraintTop_toBottomOf="@+id/cb_hide_ar_point"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/cb_ar_hide_icon"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@+id/cb_hide_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <CheckBox
            android:id="@+id/cb_hide_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="1"
            android:scaleY="1"
            app:layout_constraintTop_toBottomOf="@+id/cb_hide_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/cb_ar_hide_text"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@+id/cb_hide_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_intelligent_sensor_layout"
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:background="@color/white"
        app:layout_constraintStart_toEndOf="@+id/button_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/btn_sensing_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="vertical"
                android:text="sensing data"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:padding="8dp" />
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
