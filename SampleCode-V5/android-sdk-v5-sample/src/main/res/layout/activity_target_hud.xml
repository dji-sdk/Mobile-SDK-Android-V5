<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. लाइव ड्रोन कैमरा फीड -->
    <SurfaceView
        android:id="@+id/video_surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. पतली ग्रिड लाइनें (Grid Lines) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="4">
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#40FFFFFF" />
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#40FFFFFF" />
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#40FFFFFF" />
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="3">
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#40FFFFFF" />
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#40FFFFFF" />
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>

    <!-- 3. सेंटर रेड क्रॉसहेयर (+) -->
    <View
        android:layout_width="60dp"
        android:layout_height="5dp"
        android:layout_centerInParent="true"
        android:background="#E53935" />
    <View
        android:layout_width="5dp"
        android:layout_height="60dp"
        android:layout_centerInParent="true"
        android:background="#E53935" />

    <!-- 4. टॉप स्टेटस बार -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tv_connection_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="EDS | DRONE: DISCONNECTED | OT: 000°"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DIST: 0m"
            android:textColor="#FFD54F"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_battery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="DRONE: 0%  RC: 0%"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_rth"
            android:layout_width="55dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#C62828"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="RTH"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5. बायां बॉक्स: LOCKED TARGET (SAVED) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="14dp"
        android:layout_marginTop="48dp"
        android:background="#A61A1A1A"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOCKED TARGET (SAVED)"
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_locked_easting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Easting  : ------"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_locked_northing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Northing: -------"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_locked_height"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Height   : --- m (0°)"
            android:textColor="#69F0AE"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 6. दायां बॉक्स: FALL OF SHOTS (Correction) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="14dp"
        android:background="#A61A1A1A"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FALL OF SHOTS (Correction)"
            android:textColor="#4FC3F7"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_shot_coords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="S1 E:------ N:-------"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_correction_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="LEFT 0 | ADD 0"
            android:textColor="#40C4FF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 7. बॉटम बार और कंट्रोल बटन -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#B3000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tv_live_target"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TGT E: ------ | N: ------- | H: ---m (0°)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_mic"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#2E7D32"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="MIC: ON"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_lock_target"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#1976D2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="LOCK TARGET"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_record_shot"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#EF6C00"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="RECORD SHOT"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
