<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 四个 Demo 顶部共用的视觉档位：规范标题栏 + plugin-sample 按钮/徽章。 -->
    <dimen name="demo_top_bar_height">48dp</dimen>
    <dimen name="demo_top_bar_title_size">15sp</dimen>
    <dimen name="demo_top_bar_edge">16dp</dimen>
    <dimen name="demo_top_bar_badge_gap">6dp</dimen>
    <color name="demo_top_bar_bg">#FFFFFFFF</color>
    <color name="demo_top_bar_title">#FF1A1A3A</color>
    <color name="demo_top_bar_divider">#FFE8E8F0</color>
    <color name="demo_top_bar_connected">#FF00C774</color>
    <color name="demo_top_bar_error">#FFE03030</color>
    <color name="demo_top_bar_neutral">#FFA0A0A0</color>
    <color name="demo_top_bar_blue">#FF007BFF</color>
    <color name="demo_top_bar_button_pressed">#FFE6F2FF</color>
    <color name="demo_top_bar_disabled_bg">#FFF2F2F6</color>
    <color name="demo_top_bar_disabled_border">#FFDADAEA</color>

    <style name="DemoTopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/demo_top_bar_height</item>
        <item name="android:background">@color/demo_top_bar_bg</item>
        <item name="android:paddingStart">@dimen/demo_top_bar_edge</item>
        <item name="android:paddingEnd">@dimen/demo_top_bar_edge</item>
    </style>
    <style name="DemoTopBarTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textColor">@color/demo_top_bar_title</item>
        <item name="android:textSize">@dimen/demo_top_bar_title_size</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="DemoTopBarBackButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/bg_demo_top_bar_back</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/demo_top_bar_button_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="DemoTopBarBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>
    <style name="DemoTopBarBadgeDot">
        <item name="android:layout_width">6dp</item>
        <item name="android:layout_height">6dp</item>
        <item name="android:background">@drawable/bg_status_dot</item>
        <item name="android:backgroundTint">@color/demo_top_bar_neutral</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="DemoTopBarBadgeText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textColor">@color/demo_top_bar_neutral</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
