<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="horizontal">

    <LinearLayout android:layout_width="280dp" android:layout_height="match_parent" android:background="#F8FAFB" android:orientation="vertical" android:padding="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/current_transfers" android:textColor="#596572" android:textStyle="bold" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/ll_transfer_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E3E8EC" />

    <ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/tv_transfer_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#17212B" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/transfer_progress" android:textColor="#25313D" android:textStyle="bold" />
            <TextView android:id="@+id/tv_transfer_percent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#17212B" android:textSize="34sp" android:textStyle="bold" />
            <ProgressBar android:id="@+id/pb_transfer" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp" android:max="100" />
            <TextView android:id="@+id/tv_transfer_metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_ft_panel" android:padding="14dp" android:textColor="#56616C" android:textSize="13sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/session_info" android:textColor="#25313D" android:textStyle="bold" />
            <TextView android:id="@+id/tv_session_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_ft_panel" android:padding="14dp" android:textColor="#56616C" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="14dp" android:orientation="horizontal">
                <Button android:id="@+id/btn_pause_resume" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/pause" android:textAllCaps="false" />
                <Button android:id="@+id/btn_retry" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_weight="1" android:text="@string/retry" android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
